# --- Required ---
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...

# --- Optional (defaults shown) ---
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# PINECONE_INDEX=it-helpdesk
# PINECONE_NAMESPACE=kb
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=4
# Cosine similarity cutoff; chunks scoring below this are ignored.
# text-embedding-3-* scores are lower than older models, so keep this modest.
# SCORE_THRESHOLD=0.45
# MEMORY_MAX_TURNS=6
